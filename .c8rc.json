{
  "all": true,
  "src": [
    "ui"
  ],
  "include": [
    "ui/cd-pressure.js",
    "ui/cd-state.js",
    "ui/cd-config.js",
    "ui/cd-cpi.js",
    "ui/cd-field.js",
    "ui/cd-civ-tuning.js",
    "ui/cd-calibration.js",
    "ui/cd-pass.js",
    "ui/cd-recede.js",
    "ui/cd-diagnostics.js",
    "ui/cd-pending.js"
  ],
