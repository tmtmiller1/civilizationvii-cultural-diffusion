<?xml version="1.0" encoding="utf-8"?>
<Mod id="cultural-diffusion" version="1" xmlns="ModInfo">
    <Properties>
        <Name>LOC_MOD_CULTURAL_DIFFUSION_NAME</Name>
        <Description>LOC_MOD_CULTURAL_DIFFUSION_DESCRIPTION</Description>
        <Authors>Tower</Authors>
        <SpecialThanks>Gedemon's "Cultural Diffusion" mod for Civilization V (v18), whose reaction-diffusion culture model is the core layer this mod builds on and extends.</SpecialThanks>
        <Package>CulturalDiffusionMod</Package>
        <PackageSortIndex>1000</PackageSortIndex>
        <Version>1.5.2</Version>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet></AlwaysMet>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="cultural-diffusion-shell" scope="shell" criteria="always">
            <Properties>
                <LoadOrder>60</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/ModText.xml</Item>
                    <Item locale="de_DE">text/de_de/ModText.xml</Item>
                    <Item locale="es_ES">text/es_es/ModText.xml</Item>
                    <Item locale="fr_FR">text/fr_fr/ModText.xml</Item>
                    <Item locale="it_IT">text/it_it/ModText.xml</Item>
                    <Item locale="ja_JP">text/ja_jp/ModText.xml</Item>
                    <Item locale="ko_KR">text/ko_kr/ModText.xml</Item>
                    <Item locale="pl_PL">text/pl_pl/ModText.xml</Item>
                    <Item locale="pt_BR">text/pt_br/ModText.xml</Item>
                    <Item locale="ru_RU">text/ru_ru/ModText.xml</Item>
                    <Item locale="zh_Hans_CN">text/zh_cn/ModText.xml</Item>
                    <Item locale="zh_Hant_HK">text/zh_hk/ModText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
                    <Item>ui/settings-keeper.js</Item>
                    <Item>ui/cd-config.js</Item>
                    <Item>ui/cd-settings.js</Item>
                    <Item>ui/cd-options.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
        <ActionGroup id="cultural-diffusion-game" scope="game" criteria="always">
            <Properties>
                <LoadOrder>60</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/cd-civilopedia.xml</Item>
                </UpdateDatabase>
                <UpdateText>
                    <Item>text/en_us/ModText.xml</Item>
                    <Item>text/en_us/PediaText.xml</Item>
                    <Item locale="de_DE">text/de_de/ModText.xml</Item>
                    <Item locale="de_DE">text/de_de/PediaText.xml</Item>
                    <Item locale="es_ES">text/es_es/ModText.xml</Item>
                    <Item locale="es_ES">text/es_es/PediaText.xml</Item>
                    <Item locale="fr_FR">text/fr_fr/ModText.xml</Item>
                    <Item locale="fr_FR">text/fr_fr/PediaText.xml</Item>
                    <Item locale="it_IT">text/it_it/ModText.xml</Item>
                    <Item locale="it_IT">text/it_it/PediaText.xml</Item>
                    <Item locale="ja_JP">text/ja_jp/ModText.xml</Item>
                    <Item locale="ja_JP">text/ja_jp/PediaText.xml</Item>
                    <Item locale="ko_KR">text/ko_kr/ModText.xml</Item>
                    <Item locale="ko_KR">text/ko_kr/PediaText.xml</Item>
                    <Item locale="pl_PL">text/pl_pl/ModText.xml</Item>
                    <Item locale="pl_PL">text/pl_pl/PediaText.xml</Item>
                    <Item locale="pt_BR">text/pt_br/ModText.xml</Item>
                    <Item locale="pt_BR">text/pt_br/PediaText.xml</Item>
                    <Item locale="ru_RU">text/ru_ru/ModText.xml</Item>
                    <Item locale="ru_RU">text/ru_ru/PediaText.xml</Item>
                    <Item locale="zh_Hans_CN">text/zh_cn/ModText.xml</Item>
                    <Item locale="zh_Hans_CN">text/zh_cn/PediaText.xml</Item>
                    <Item locale="zh_Hant_HK">text/zh_hk/ModText.xml</Item>
                    <Item locale="zh_Hant_HK">text/zh_hk/PediaText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
                    <Item>ui/settings-keeper.js</Item>
                    <Item>ui/cd-bootstrap.js</Item>
                    <Item>ui/cd-settings.js</Item>
                    <Item>ui/cd-options.js</Item>
                    <Item>ui/cd-pressure-lens.js</Item>
                    <Item>ui/cd-pressure-tooltip.js</Item>
                </UIScripts>
                <ImportFiles>
                    <Item>ui/cd-log.js</Item>
                    <Item>ui/cd-config.js</Item>
                    <Item>ui/cd-lens-colors.js</Item>
                    <Item>ui/cd-state.js</Item>
                    <Item>ui/cd-plots.js</Item>
                    <Item>ui/cd-polity.js</Item>
                    <Item>ui/cd-pressure.js</Item>
                    <Item>ui/cd-field.js</Item>
                    <Item>ui/cd-terrain.js</Item>
                    <Item>ui/cd-cpi.js</Item>
                    <Item>ui/cd-emigration.js</Item>
                    <Item>ui/cd-metrics.js</Item>
                    <Item>ui/cd-ethnicity.js</Item>
                    <Item>ui/cd-civ-roster.js</Item>
                    <Item>ui/cd-civ-tuning.js</Item>
                    <Item>ui/cd-calibration.js</Item>
                    <Item>ui/cd-borders.js</Item>
                    <Item>ui/cd-teardown.js</Item>
                    <Item>ui/cd-ownership.js</Item>
                    <Item>ui/cd-pending.js</Item>
                    <Item>ui/cd-diagnostics.js</Item>
                    <Item>ui/cd-recede.js</Item>
                    <Item>ui/cd-conversion.js</Item>
                    <Item>ui/cd-inject.js</Item>
                    <Item>ui/cd-flip.js</Item>
                    <Item>ui/cd-ai-flips.js</Item>
                    <Item>ui/cd-capture.js</Item>
                    <Item>ui/cd-conquest.js</Item>
                    <Item>ui/cd-units.js</Item>
                    <Item>ui/cd-age-guard.js</Item>
                    <Item>ui/cd-eligibility.js</Item>
                    <Item>ui/cd-pass.js</Item>
                    <Item>ui/cd-notifications.js</Item>
                </ImportFiles>
            </Actions>
        </ActionGroup>
    </ActionGroups>
    <LocalizedText>
        <File>text/en_us/ModText.xml</File>
        <File>text/en_us/PediaText.xml</File>
    </LocalizedText>
</Mod>
