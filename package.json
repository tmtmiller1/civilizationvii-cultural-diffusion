{
  "name": "cultural-diffusion-mod-dev",
  "version": "0.1.0",
  "private": true,
  "description": "Dev-only tooling for the Cultural Diffusion Civ VII mod (lint + syntax + ESM integrity + unit tests + coverage + mutation). Not shipped.",
  "type": "module",
  "scripts": {
    "lint": "eslint ui tests scripts",
    "check:syntax": "for f in ui/*.js; do node --check \"$f\" || exit 1; done",
    "check:esm": "node ./scripts/check-esm.mjs",
    "test:pressure": "node --loader ./tests/loader.mjs ./tests/pressure.mjs",
    "test:pressure-branches": "node --loader ./tests/loader.mjs ./tests/pressure-branches.mjs",
    "test:state": "node --loader ./tests/loader.mjs ./tests/state.mjs",
    "test:state-branches": "node --loader ./tests/loader.mjs ./tests/state-branches.mjs",
    "test:config": "node --loader ./tests/loader.mjs ./tests/config.mjs",
    "test:cpi": "node --loader ./tests/loader.mjs ./tests/cpi.mjs",
    "test:cpi-branches": "node --loader ./tests/loader.mjs ./tests/cpi-branches.mjs",
    "test:field": "node --loader ./tests/loader.mjs ./tests/field.mjs",
    "test:field-branches": "node --loader ./tests/loader.mjs ./tests/field-branches.mjs",
    "test:pressure-verdict": "node --loader ./tests/loader.mjs ./tests/pressure-verdict.mjs",
    "test:civtuning": "node --loader ./tests/loader.mjs ./tests/civ-tuning.mjs",
    "test:civtuning-branches": "node --loader ./tests/loader.mjs ./tests/civ-tuning-branches.mjs",
    "test:civtuning-internals": "node --loader ./tests/loader.mjs ./tests/civ-tuning-internals.mjs",
    "test:calibration": "node --loader ./tests/loader.mjs ./tests/calibration.mjs",
    "test:calibration-branches": "node --loader ./tests/loader.mjs ./tests/calibration-branches.mjs",
    "test:settings": "node --loader ./tests/loader.mjs ./tests/settings.mjs",
    "test:options": "node --loader ./tests/loader.mjs ./tests/options.mjs",
    "test:ownership": "node --loader ./tests/loader.mjs ./tests/ownership.mjs",
    "test:pass": "node --loader ./tests/loader.mjs ./tests/pass.mjs",
    "test:repair": "node --loader ./tests/loader.mjs ./tests/repair.mjs",
    "test:buffer": "node --loader ./tests/loader.mjs ./tests/buffer.mjs",
    "test:terrain": "node --loader ./tests/loader.mjs ./tests/terrain.mjs",
    "test": "npm run test:pressure && npm run test:pressure-branches && npm run test:state && npm run test:state-branches && npm run test:config && npm run test:cpi && npm run test:cpi-branches && npm run test:field && npm run test:field-branches && npm run test:pressure-verdict && npm run test:civtuning && npm run test:civtuning-branches && npm run test:civtuning-internals && npm run test:calibration && npm run test:calibration-branches && npm run test:settings && npm run test:options && npm run test:ownership && npm run test:pass && npm run test:repair && npm run test:buffer && npm run test:terrain",
    "test:js": "npm test",
    "coverage": "c8 npm run test:js",
    "hotspots": "node scripts/hotspot-score.mjs",
    "inventory": "node scripts/inventory.mjs --md",
    "mutation": "stryker run",
    "duplication": "jscpd ui --reporters json,console --output reports/jscpd --gitignore",
    "verify": "npm run lint && npm run check:syntax && npm run check:esm && npm test"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "c8": "^11.0.0",
    "eslint": "^9.0.0",
    "jscpd": "^4.2.5"
  }
}
